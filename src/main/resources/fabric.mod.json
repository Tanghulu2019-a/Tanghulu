{
  "schemaVersion": 1,
  "id": "tanghulu",
  "version": "${version}",
  "name": "Tanghulu",
  "description": "糖葫芦无敌缝合插件 | GitHub: https://github.com/Tanghulu2019-a/Tanghulu",
  "authors": [
    "Tanghulu2019"
  ],
  "contributors": [
    "Cqb13",
    "Mikumiku",
    "Jefff"
  ],
  "icon": "assets/tanghulu/icon.png",
  "environment": "client",
  "entrypoints": {
    "preLaunch": [
      "dev.tanghulu.addon.ok.PreLaunchInitializer"
    ],
    "meteor": [
      "dev.tanghulu.addon.ok.TanghuluAddon"
    ]
  },
  "mixins": [
    "tanghulu.mixins.json",
    "ancient-apple-hunter.mixins.json",
    "ancient-apple-hunter.xaero.mixins.json",
    "tanghulu-stash.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25"
  },
  "depends": {
    "java": ">=21",
    "minecraft": "1.21.11",
    "fabricloader": ">=0.18.2",
    "meteor-client": "1.21.11-86"
  },
  "license": "GPL-3.0-only",
  "suggests": {
    "baritone": "*",
    "litematica": "*",
    "malilib": "*",
    "xaerominimap": ">=26.4.2",
    "xaeroworldmap": ">=1.44.2",
    "minihud": "*",
    "xaeroplus": ">=2.35.1"
  },
  "contact": {
    "homepage": "https://github.com/Tanghulu2019-a/Tanghulu",
    "sources": "https://github.com/Tanghulu2019-a/Tanghulu",
    "issues": "https://github.com/Tanghulu2019-a/Tanghulu/issues"
  }
}
